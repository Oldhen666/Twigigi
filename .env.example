# Public site origin used for share links, QR codes, and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the seller session cookie. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Stripe. The secret key also runs Stripe Connect for digital-file card payments. The webhook must listen to events on connected accounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Checkout for digital files. The buyer pays the seller's PayPal email. Twigigi is notified and emails the file. Use live in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Comma-separated seller emails that can open the admin books.
ADMIN_EMAILS=

# Mail for password reset, new orders, and quote requests. Leave blank until a mailbox is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Twigigi <noreply@twigigi.com>
