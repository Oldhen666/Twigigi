# Public site origin used for share links, QR codes, and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs the seller session cookie. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Optional. Kept for older Stripe Checkout sessions. New card payments use the seller's own payment link.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monthly platform fee for one live Twig, in cents. Leave blank until the price is chosen.
TWIG_MONTHLY_CENTS=

# Comma-separated seller emails that can open the admin books.
ADMIN_EMAILS=

# Password reset email. Leave blank until a mailbox is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Twigigi <noreply@twigigi.com>
